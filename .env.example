# ========== LLM 配置 ==========
# 模型名称（支持 Claude / GPT / DeepSeek / 智谱 GLM）
# Claude: claude-sonnet-4-20250514, claude-opus-4-20250514
# OpenAI: gpt-4o, gpt-4-turbo, gpt-4o-mini
# DeepSeek: deepseek-chat, deepseek-v4-flash (base_url 可留空，自动补)
# 智谱: glm-5.3-flash, glm-5.3-flashx (base_url 可留空，自动补)
# Ollama: 本地模型名 (需配 base_url=http://localhost:11434/v1)
LLM_MODEL="deepseek-chat"

# API Key（必填，填入你自己的 Key，不要把真实 Key 提交到仓库）
LLM_API_KEY="your-api-key-here"

# API Base URL（可选，OpenAI兼容API时填写；留空则按模型名自动补）
# DeepSeek: https://api.deepseek.com/v1
# 智谱 GLM: https://open.bigmodel.cn/api/paas/v4
#   如果用的是 GLM Coding Plan 套餐，改成 https://open.bigmodel.cn/api/coding/paas/v4
# Ollama: http://localhost:11434/v1
LLM_BASE_URL="https://api.deepseek.com/v1"




# LLM 参数
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ========== 数据配置 ==========
DEFAULT_LOOKBACK_DAYS=365
MAX_NEWS_ITEMS=20

# ========== Agent 配置 ==========
AGENT_MAX_RETRIES=2
DATA_FETCH_TIMEOUT=15
